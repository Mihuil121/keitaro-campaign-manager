# Адрес трекера (без /admin)
KEITARO_URL=https://tlgk.host
# API-ключ: админка Keitaro -> Обслуживание -> Пользователи -> API-ключи
KEITARO_API_KEY=put-your-key-here

# Значения по умолчанию для создаватора (можно ID или имя; пусто = выбирать в UI)
KEITARO_DEFAULT_DOMAIN=
KEITARO_DEFAULT_GROUP=FORTESTS
KEITARO_DEFAULT_SOURCE=FORTESTS

# Куда отправлять трафик из выбранного гео
SAFE_REDIRECT_URL=https://google.com

# БД (по умолчанию SQLite-файл; для Postgres: postgresql+psycopg://user:pass@localhost/keitaro)
DATABASE_URL=sqlite:///./app.db

# Откуда разрешены запросы к API (адрес Next.js)
CORS_ORIGINS=http://localhost:3000
